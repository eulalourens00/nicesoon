<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:nicesoon.ViewModels"
             x:Class="nicesoon.Pages.AuthPages.LoginPage">

    <VerticalStackLayout>
        <Grid VerticalOptions="Center" HorizontalOptions="Center">
            <Frame Style="{StaticResource FrameStyle}">
                
                <VerticalStackLayout Spacing="25" HorizontalOptions="Fill" VerticalOptions="Fill" >

                    <Label Text="Войти в свой аккаунт" Style="{StaticResource BigLabels}"/>

                    <VerticalStackLayout Spacing="15" HorizontalOptions="Fill" VerticalOptions="Center">

                        <!-- phone -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Телефон" Style="{StaticResource DefLabels2}"/>
                            <Entry Text="{Binding Phone}" Style="{StaticResource EntriesStyle}"/>
                        </VerticalStackLayout>

                        <!-- passw -->
                        <VerticalStackLayout Spacing="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Label Text="Пароль" Style="{StaticResource DefLabels2}" HorizontalOptions="Start" Grid.Column="0"/>
                                <Label x:Name="ForgetPassword" Text="Забыли?" TextColor="{StaticResource LinksColor}" 
                                   Style="{StaticResource DefLabels2}" HorizontalOptions="End" Grid.Column="1">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                            
                            <Grid>
                                <Entry Text="{Binding Password}" 
                                       IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolConverter}}"
                                       Style="{StaticResource EntriesStyle}"/>

                                <ImageButton Source="showbutton.png"
                                             Command="{Binding TogglePasswordCommand}"
                                             Style="{StaticResource ShowButton2}"/>
                                         
                            </Grid>
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                    <!-- to main page -->
                    <Button Command="{Binding LoginCommand}" 
                            Text="Войти" 
                            Style="{StaticResource ButtonStyle}"/>

                    <!-- link to regist -->
                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center"  Spacing="5" Margin="0,10,0,0">
                        <Label Text="У вас нет аккаунта?" FontSize="14" TextColor="{StaticResource MiniText}"/>
                        <Label Text="Зарегистрироваться" FontSize="14" TextColor="{StaticResource LinksColor}">
                            
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RegisterCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                        
                    </StackLayout>

                </VerticalStackLayout>
            </Frame>

            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                           IsVisible="{Binding IsLoading}" 
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

            <Label Text="{Binding ErrorMessage}" 
               TextColor="#8c1531" HorizontalOptions="Center"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                />

        </Grid>
    </VerticalStackLayout>
</ContentPage>