<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="nicesoon.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:nicesoon"
    xmlns:pages="clr-namespace:nicesoon.Pages"
    xmlns:auth="clr-namespace:nicesoon.Pages.AuthPages"
    Shell.FlyoutBehavior="Disabled"
    Title="nicesoon">

    <ShellContent Title="Главная"
                  Route="main"
                  ContentTemplate="{DataTemplate local:MainPage}" />

    <ShellContent Title="Вход"
                  Route="login"
                  ContentTemplate="{DataTemplate auth:LoginPage}" />

</Shell>
